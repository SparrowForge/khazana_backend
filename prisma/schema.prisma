  unitPrice Decimal?             @map("UnitPrice") @db.Decimal(9, 2)
  serialNo  String?              @map("SerialNo")
  vatPrice  Decimal?             @map("VatPrice") @db.Decimal(18, 2)
  amount    Decimal?             @map("Amount") @db.Decimal(18, 2)
  // This line's share of OrderReceive_Master.discount (a % of the VAT-inclusive
  // total), spread pro-rata by the line's VAT-inclusive value. An order carries
  // no per-line discount, so this column holds the whole of the line's discount.
