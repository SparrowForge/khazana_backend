model OrderReceive_Detail {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @map("ID") @db.Uuid
  masterId  String?              @map("MasterId") @db.Uuid
  itemId    String?              @map("ItemID") @db.Uuid
