// ==================== ITEM TRANSACTIONS ====================

model Item_Receive {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @map("ID") @db.Uuid
  serialNo        String?           @map("SerialNo")
  voucharNo       String?           @map("VoucharNo")
  itemId          String?           @map("ItemId") @db.Uuid
  itemName        String?           @map("ItemName")
  qty             Decimal?          @map("Qty") @db.Decimal(9, 2)
  purDate         DateTime?         @map("Pur_Date")
  isActive        Int?              @map("IsActive")
  createBy        String?           @map("CreateBy")
  createDate      DateTime?         @map("CreateDate")
  updateBy        String?           @map("UpdateBy")
  updateDate      DateTime?         @map("UpdateDate")
  branchId        String            @map("BranchId") @db.Uuid
  receiveBranchID String?           @map("ReceiveBranchID") @db.Uuid
  /// The Stock Issue document this receive confirms; null when the receive was
  /// entered by hand. See InventoryService#confirmReceive.
  issueSerialNo   String?           @map("IssueSerialNo") @db.VarChar(50)
  item            Item_Information? @relation(fields: [itemId], references: [id])

  @@index([issueSerialNo])
  @@map("Item_Receive")
}

model Item_Issue {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @map("ID") @db.Uuid
  serialNo        String?           @map("SerialNo")
  voucharNo       String?           @map("VoucharNo")
  itemId          String?           @map("ItemId") @db.Uuid
  unitPrice       Decimal?          @map("UnitPrice") @db.Decimal(18, 6)
  qty             Decimal?          @map("Qty") @db.Decimal(18, 6)
  issueDate       DateTime?         @map("IssueDate")
  issueBranchId   String            @map("IssueBranchId") @db.Uuid
  receiveBranchId String            @map("ReceiveBranchId") @db.Uuid
  /// 1 = this line was also written to Production as part of the same document.
  /// See ProductionService#syncFromIssue.
  isProduction    Int               @default(0) @map("IsProduction")
  /// Receipt handshake: 0 = pending at the receiving branch, 1 = confirmed.
  /// Set for the whole SerialNo group at once. Transfers ('TRF-...') are born
  /// received because they write both legs immediately.
  isReceived      Int               @default(0) @map("IsReceived")
  receivedDate    DateTime?         @map("ReceivedDate")
  receivedBy      String?           @map("ReceivedBy") @db.VarChar(50)
  isActive        Int?              @map("IsActive")
  createBy        String?           @map("CreateBy")
  createDate      DateTime?         @map("CreateDate")
  updateBy        String?           @map("UpdateBy")
  updateDate      DateTime?         @map("UpdateDate")
  item            Item_Information? @relation(fields: [itemId], references: [id])

  @@index([receiveBranchId, isReceived])
  @@map("Item_Issue")
}

/// Vehicle Challan — the gate pass for a loaded van leaving the factory on a
/// route, before anyone knows which outlet will take what.
///
/// Deliberately has NO destination branch and NO stock effect. The van tours the
/// outlets; whatever an outlet keeps is entered as a real Stock Issue at that
/// point, and the rest comes back. This document exists only so security and
/// the factory can account for what physically left on the vehicle.
///
/// Shares Item_Issue's shape: one row per item line, every line of a document
/// carrying the same SerialNo, which is what the API addresses.
model Vehicle_Challan {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @map("ID") @db.Uuid
  serialNo     String?           @map("SerialNo")
  voucharNo    String?           @map("VoucharNo")
  /// Catalogue item, when the line was picked from Item_Information. NULL for
  /// an ad-hoc line typed straight onto the challan.
  itemId       String?           @map("ItemId") @db.Uuid
  /// Printed description. Always written, catalogue or not: an ad-hoc line has
  /// nowhere else to keep its name, and snapshotting a catalogue one means the
  /// challan still reads as it was issued after the item is renamed.
  itemName     String?           @map("ItemName")
  uom          String?           @map("Uom")
  qty          Decimal?          @map("Qty") @db.Decimal(18, 6)
  challanDate  DateTime?         @map("ChallanDate")
  /// Who the challan is made out to. Typed by hand — a challan can be raised
  /// for a party that has no Customer record.
  customerName    String?        @map("CustomerName")
  customerAddress String?        @map("CustomerAddress")
  deliveryAddress String?        @map("DeliveryAddress")
  /// Who to ask for on delivery, and the customer purchase order the goods go
  /// against. Printed on the A4 challan, which carried the labels blank before
  /// these columns existed.
  contactPerson   String?        @map("ContactPerson")
  contactNo       String?        @map("ContactNo")
  poNo            String?        @map("PoNo")
  poDate          DateTime?      @map("PoDate")
  /// The despatching branch (the factory). There is no receiving branch.
  branchId     String            @map("BranchId") @db.Uuid
  /// Where the van is headed — free text, printed as the "To:" heading.
  route        String?           @map("Route")
  vehicleNo    String?           @map("VehicleNo")
  driverName   String?           @map("DriverName")
  driverMobile String?           @map("DriverMobile")
  remarks      String?           @map("Remarks")
  isActive     Int?              @map("IsActive")
  createBy     String?           @map("CreateBy")
  createDate   DateTime?         @map("CreateDate")
  updateBy     String?           @map("UpdateBy")
  updateDate   DateTime?         @map("UpdateDate")
  item         Item_Information? @relation(fields: [itemId], references: [id])

  @@index([branchId, challanDate])
  @@index([serialNo])
  @@map("Vehicle_Challan")
}

/// Production Entry — factory-only record of manufactured output. One row per
/// item line; all lines of one entry share a `serialNo` (PRD-...) so the
/// document can be grouped, edited and deleted as a unit, like Item_Issue.
/// `rate` is the VAT-INCLUSIVE unit price (Item_Issue.unitPrice is not).
model Production {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @map("ID") @db.Uuid
  serialNo       String?           @map("SerialNo") @db.VarChar(50)
  branchId       String?           @map("BranchId") @db.Uuid
  productionDate DateTime?         @map("ProductionDate")
  itemId         String?           @map("ItemId") @db.Uuid
  rate           Decimal?          @map("Rate") @db.Decimal(18, 6)
  qty            Decimal?          @map("Qty") @db.Decimal(18, 6)
  remarks        String?           @map("Remarks") @db.VarChar(500)
  /// Set when this row was produced BY a Stock Issue document (its SerialNo);
  /// null for entries made directly on the Production Entry screen. The issue's
  /// edit path deletes and rewrites every row carrying its serial.
  issueSerialNo  String?           @map("IssueSerialNo") @db.VarChar(50)
  isActive       Int?              @map("IsActive")
  createBy       String?           @map("CreateBy") @db.VarChar(50)
  createDate     DateTime?         @map("CreateDate")
  updateBy       String?           @map("UpdateBy") @db.VarChar(50)
  updateDate     DateTime?         @map("UpdateDate")
  item           Item_Information? @relation(fields: [itemId], references: [id])

  @@index([serialNo])
  @@index([branchId])
  @@index([itemId])
  @@index([productionDate])
  @@index([issueSerialNo])
  @@map("Production")
}

model ItemReject {
